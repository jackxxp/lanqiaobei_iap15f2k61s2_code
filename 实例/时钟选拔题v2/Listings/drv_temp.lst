  99          // 读取温度值（返回*10格式）
 100          //==============================================================================
 101          int read_temp_int(void)
 102          {
 103   1          unsigned char high, low;
 104   1          int raw_temp;
 105   1          int result;
 106   1          
 107   1          // 启动温度转换
 108   1          init_ds18b20();
 109   1          Write_DS18B20(0xCC);  // 跳过ROM
 110   1          Write_DS18B20(0x44);  // 启动转换
 111   1          
 112   1          // 等待转换完成（11位分辨率需要375ms）
 113   1          // 200 * 12 * 12 ≈ 750ms 是12位的时间
 114   1          // 11位分辨率需要375ms，所以用100
 115   1          Delay_OneWire(100);    // 100 * 12 * 12 ≈ 375ms
 116   1          
C51 COMPILER V9.60.7.0   DRV_TEMP                                                          03/05/2026 13:11:39 PAGE 3   

 117   1          // 读取温度值
 118   1          init_ds18b20();
 119   1          Write_DS18B20(0xCC);  // 跳过ROM
 120   1          Write_DS18B20(0xBE);  // 读取暂存器
 121   1          
 122   1          low = Read_DS18B20();   // 读低字节
 123   1          high = Read_DS18B20();  // 读高字节
 124   1          
 125   1          raw_temp = (high << 8) | low;
 126   1          
 127   1          // 转换为*10格式
 128   1          if(raw_temp & 0x8000)  // 负温度
 129   1          {
 130   2              raw_temp = ~raw_temp + 1;
 131   2              result = - (raw_temp * 10 / 16);
 132   2          }
 133   1          else  // 正温度
 134   1          {
 135   2              result = raw_temp * 10 / 16;
 136   2          }
 137   1          
 138   1          return result;  // 返回*10格式
 139   1      }


