  59          void rtc_init()
  60          {
  61   1          RST=0;SCK=0;SDA=0;
  62   1          Write_Ds1302_Byte(0x8e,0x00);
  63   1          Write_Ds1302_Byte(0x80,hex_to_bcd(10)&0x7f);
  64   1      }
  65          void rtc_set(rtc_type *time)
  66          {
  67   1          Write_Ds1302_Byte(0x8E, 0x00);  // 关闭写保护
  68   1          
  69   1          Write_Ds1302_Byte(0x80, hex_to_bcd(time->s));      // 秒
  70   1          Write_Ds1302_Byte(0x82, hex_to_bcd(time->m));      // 分
  71   1          Write_Ds1302_Byte(0x84, hex_to_bcd(time->h));      // 时
  72   1          Write_Ds1302_Byte(0x86, hex_to_bcd(time->day));      // 日
  73   1          Write_Ds1302_Byte(0x88, hex_to_bcd(time->mon));      // 月
  74   1          Write_Ds1302_Byte(0x8A, hex_to_bcd(time->week));      // 星期
  75   1          Write_Ds1302_Byte(0x8C, hex_to_bcd(time->year));      // 年
  76   1          
  77   1          Write_Ds1302_Byte(0x8E, 0x80);  // 开启写保护
  78   1      }
  79          void rtc_get(rtc_type *time)
  80          {
  81   1          time->s = bcd_to_hex(Read_Ds1302_Byte(0x81) & 0x7F);   // 秒（屏蔽第7位）
  82   1          time->m = bcd_to_hex(Read_Ds1302_Byte(0x83) & 0x7F);   // 分
  83   1          time->h = bcd_to_hex(Read_Ds1302_Byte(0x85) & 0x3F);   // 时（24小时制）
