 118          u8 eeprom_r(u8 addr)
 119          {
 120   1          u8 Data;
 121   1      
 122   1          I2CStart();
 123   1          I2CSendByte(0xA0);      // 先发设备地址（写）
 124   1          I2CWaitAck();           // AT24C02 应答
 125   1          I2CSendByte(addr);   // 再发存储地址
 126   1          I2CWaitAck();           // AT24C02 应答
 127   1      
 128   1          I2CStart();
 129   1          I2CSendByte(0xA1);      // 设备地址（读）
 130   1          I2CWaitAck();
 131   1          Data = I2CReceiveByte();
 132   1          I2CSendAck(1);
 133   1          I2CStop();
 134   1          
 135   1          return Data;
 136   1      }
